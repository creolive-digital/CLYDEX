# Documentation only: CLYDEX does not auto-load .env files.
# Set values in the launching environment. Never place real secrets here.
CLYDEX_ALLOW_CLOUD=true
CLYDEX_PRIVACY_MODE=false
CLYDEX_APPROVAL_TIMEOUT=120
# Optional public application identifier, not a client secret:
CLYDEX_OUTLOOK_CLIENT_ID=
# Phase 02 provider credentials belong in Windows Credential Manager, configured
# through AI & Memory. Provider API keys are not read from this file/environment.
# No provider key is required for the existing logged-in Codex CLI.
# Models/endpoints/budgets are per-user settings; all six new providers default off.
