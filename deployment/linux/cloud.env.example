# No credentials. Production DSN is a separate mode-0600 file, never an env value.
CLYDEX_ENVIRONMENT=production
CLYDEX_PUBLIC_HOST=cloud.example.invalid
CLYDEX_REQUIRE_TLS=true
CLYDEX_DATA_ROOT=/var/lib/clydex
CLYDEX_SECRETS_ROOT=/run/secrets/clydex
CLYDEX_DATABASE_URL_FILE=/run/secrets/database-url
CLYDEX_REGISTRATION_ENABLED=false
CLYDEX_DOCS_ENABLED=false
CLYDEX_INLINE_WORKERS=0
CLYDEX_QUOTA_BYTES=104857600
# Embeddings stay absent until owner licenses and installs a local model.
CLYDEX_LOCAL_EMBEDDINGS_CONFIRMED=false
CLYDEX_EMBEDDING_MODEL=
CLYDEX_EMBEDDING_REVISION=
CLYDEX_EMBEDDING_DIMENSIONS=0
CLYDEX_EMBEDDING_LICENSE=
